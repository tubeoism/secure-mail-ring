{
  "name": "secure-mail-ring",
  "version": "0.0.0",
  "private": true,
  "description": "Secure Mail Ring - Outlook add-in that guards recipients at send time",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:paths": "node scripts/path-guard.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:taskpane && npm run check:paths && npm run check:i18n",
    "dev:taskpane": "webpack serve --mode development --config webpack.config.mjs",
    "build:taskpane": "webpack --mode development --config webpack.config.mjs",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fluentui/react-components": "^9.75.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.10.2",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  }
}
