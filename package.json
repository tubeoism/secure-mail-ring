{
  "name": "secure-mail-ring",
  "version": "0.0.0",
  "private": true,
  "description": "Secure Mail Ring - Outlook add-in that guards recipients at send time",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:paths": "node scripts/path-guard.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run check:paths && npm run check:i18n"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
