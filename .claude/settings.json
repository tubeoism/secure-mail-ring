{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__antigravity__.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agy-tripwire.mjs"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "antigravity-agent-toolkit": {
      "source": {
        "source": "github",
        "repo": "tubeoism/antigravity-agent-toolkit",
        "ref": "stable"
      }
    }
  },
  "enabledPlugins": {
    "agy-bridge@antigravity-agent-toolkit": true
  }
}
